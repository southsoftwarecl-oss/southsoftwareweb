# Copia este archivo a .env.local y completa lo que uses. Sin claves, el sitio funciona en modo demo.

# URL pública (canonical, sitemap, OG). Dominio PLACEHOLDER: confirmar.
NEXT_PUBLIC_SITE_URL=https://southsoftware.cl

# --- Formulario de contacto (Resend) — solo servidor, NUNCA con prefijo NEXT_PUBLIC_ ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Remitente verificado en Resend (opcional; por defecto onboarding@resend.dev)
CONTACT_FROM_EMAIL=

# --- Cloudflare Turnstile (opcional) ---
# La site key es pública (va al navegador); la secret key solo al servidor.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Envíos permitidos por IP cada 10 minutos (por defecto 5)
CONTACT_RATE_LIMIT=5

# --- Google Analytics 4 / Search Console (públicas; vacías = no se renderiza nada) ---
# ID de medición GA4 (G-XXXXXXXXXX). Con valor: aviso de cookies + gtag.js tras "Aceptar".
NEXT_PUBLIC_GA_ID=
# Token de "Etiqueta HTML" de Search Console (solo el content="…"). Alternativa: verificar por DNS.
NEXT_PUBLIC_GSC_VERIFICATION=
