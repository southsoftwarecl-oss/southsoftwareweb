# Panel /admin — solo nombres, sin valores. Todo se lee en el servidor en runtime.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Opcional (solo servidor). Sin ella, la web inserta solicitudes con la publishable key vía política solo-INSERT.
SUPABASE_SECRET_KEY=
# 1 = exige verificación en dos pasos (aal2) para entrar al panel
ADMIN_REQUIRE_MFA=
# Sal para el hash de IP de las solicitudes
LEADS_IP_SALT=
# Modo provisorio sin Supabase (fase 1): contraseña única + clave de firma (≥32)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
